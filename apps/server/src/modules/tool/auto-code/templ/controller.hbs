import {
Body,
Controller,
Delete,
Get,
Param,
Post,
Put,
Query,
} from '@nestjs/common';
import { {{pascalCase}}Service } from './{{name}}.service';
import {
  Create{{pascalCase}}Dto,
  Get{{pascalCase}}ListDto,
  Update{{pascalCase}}Dto,
} from './dto/req-{{camelCase}}.dto';
import { Permission } from '@/common/decorators/permission.decorator';
import { ApiBearerAuth, ApiOperation, ApiParam, ApiTags } from '@nestjs/swagger';
import { CreateDtoPipe } from '@/common/pipes/createDto.pipe';
import { UpdateDtoPipe } from '@/common/pipes/updateDto.pipe';

{{#if primaryKeyIsNumber}}
  import {
  DelCommonNumberDto,
  DelCommonNumbersDto,
  } from '@/common/dtos/common.dto';
{{else}}
  import {
  DelCommonStringDto,
  DelCommonStringsDto,
  } from '@/common/dtos/common.dto';
{{/if}}

@ApiTags('{{nameZh}}')
@ApiBearerAuth()
@Controller('{{routePath}}')
export class {{pascalCase}}Controller {
  constructor(private readonly {{camelCase}}Service: {{pascalCase}}Service) {}
  /* 新增 */
  @Post()
  @ApiOperation({
    summary: '新增{{nameZh}}',
  })
  @Permission('{{authPrefix}}:create')
  async create(@Body(CreateDtoPipe) create{{pascalCase}}Dto: Create{{pascalCase}}Dto) {
    return this.{{camelCase}}Service.create(create{{pascalCase}}Dto);
  }

  /* 列表查询 */
  @Get()
  @ApiOperation({
    summary: '查询{{nameZh}}列表',
  })
  @Permission('{{authPrefix}}:list')
  async findAll(
  @Query() get{{pascalCase}}ListDto: Get{{pascalCase}}ListDto,
  ) {
    return this.{{camelCase}}Service.findAll(get{{pascalCase}}ListDto);
  }

  /* 通过id查询 */
  @Get(':id')
  @ApiOperation({
    summary: '查询{{nameZh}}详情',
  })
  @ApiParam({ name: 'id', description: '{{nameZh}}id' })
  @Permission('{{authPrefix}}:detail')
  async findOne(@Param('id') id: {{pimaryKeyType}}) {
    return await this.{{camelCase}}Service.findOne(id);
  }

  /* 更新 */
  @Put(':id')
  @ApiOperation({
    summary: '更新{{nameZh}}',
  })
  @ApiParam({ name: 'id', description: '{{nameZh}}id' })
  @Permission('{{authPrefix}}:update')
  async update(@Param('id') id: {{pimaryKeyType}}, @Body(UpdateDtoPipe) update{{pascalCase}}Dto: Update{{pascalCase}}Dto) {
    return this.{{camelCase}}Service.update(id, update{{pascalCase}}Dto);
  }

  /* 单个删除 */
  @Delete(':id')
  @ApiOperation({
    summary: '删除{{nameZh}}',
  })
  @ApiParam({ name: 'id', description: '{{nameZh}}id' })
  @Permission('{{authPrefix}}:remove')

  {{#if primaryKeyIsNumber}}
    async remove(@Param() params: DelCommonNumberDto) {
      return this.{{camelCase}}Service.remove(params.id);
    }
  {{else}}
    async remove(@Param() params: DelCommonStringDto) {
      return this.{{camelCase}}Service.remove(params.id);
    }
  {{/if}}

  /* 批量删除 */
  @Delete()
  @ApiOperation({
    summary: '批量删除{{nameZh}}',
  })
  @Permission('{{authPrefix}}:removes')
  {{#if primaryKeyIsNumber}}
    async removes(@Body() body: DelCommonNumbersDto) {
      return this.{{camelCase}}Service.removes(body.ids);
    }
  {{else}}
    async removes(@Body() body: DelCommonStringsDto) {
      return this.{{camelCase}}Service.removes(body.ids);
    }
  {{/if}}
}

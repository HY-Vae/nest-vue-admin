<script setup lang="ts">
import { ref, type PropType, computed, watch } from 'vue'
import { ActionEnum } from '@/enums/common'
import type { FormInstance } from 'element-plus'
import type { Create<%= pascalCase %>Type, <%= pascalCase %>ListType } from './<%= camelCase %>.type'
<% if(dictKeys && dictKeys.length > 0){%>
import { useDict } from '@/hooks/dict.hook'
import type { SelectOptionItem } from '@/types/global'
<%}%>

const props = defineProps({
  action: {
    type: String as PropType<ActionEnum>,
    default: ActionEnum.Add,
  },
  loading: {
    type: Boolean,
    default: false,
  },
  detailLoading: {
    type: Boolean,
    default: false,
  },
  current: {
    required: false,
    type: Object as PropType<<%= pascalCase %>ListType>,
  },
})

<% if(dictKeys && dictKeys.length > 0){%>
const { getDictOptions } = useDict()
<%}%>

const rowSpan = ref(24)
const visible = defineModel<boolean>({ required: true })
const emits = defineEmits(['cancel', 'confirm'])
const <%= camelCase %>FormRef = ref<FormInstance>()

const formLabelWidth = '100px'
const <%= camelCase %>Form = ref<Create<%= pascalCase %>Type>({
  <%= fields.filter(field => field.isAdd).map(function(field) {
    const defaultValue = field.defaultValue || undefined
    return field.nameJson + `: ${defaultValue}`;
  }).join(',\n    ') %>
})

const rules = {
  <%- fields.filter(field => field.isAdd).map(function(field) {
    const arr = []
    if (field.isRequired) {
      arr.push({required: true, message: `${field.nameCh}不能为空`, trigger: 'blur'})
    }
    if (field.formItemType === 'textarea' || field.formItemType === 'input') {
      arr.push({max: field.size, message: `不能超过${field.size}个字符`, trigger: 'change'})
    }

    return `${field.nameJson}: ${JSON.stringify(arr)}`;
  }).join(',\n    ') %>
}
const cancel = () => {
  visible.value = false
  emits('cancel')
}
const confirm = () => {
  <%= camelCase %>FormRef.value?.validate((valid) => {
    if (valid) {
      emits('confirm', <%= camelCase %>Form.value)
    }
  })
}

const closeDialog = () => {
  <%= camelCase %>FormRef.value?.resetFields()
    <%= camelCase %>Form.value = {
        <%= fields.filter(field => field.isAdd).map(function(field) {
            const defaultValue = field.defaultValue || undefined
            return field.nameJson + `: ${defaultValue}`;
        }).join(',\n    ') %>
    }
}

<% dictKeys && dictKeys.forEach(function(key) { %>
const <%= key %>Options = ref<SelectOptionItem[]>([])
<% }); %>

const openDialog = () => {
    <% dictKeys && dictKeys.forEach(function(key) { %>
  getDictOptions('<%= key %>').then((res) => {
      <%= key %>Options.value = res
  })
    <% }); %>
}

const title = computed(() => {
  return props.action === ActionEnum.Add ? '添加<%= nameZh %>' : '编辑<%= nameZh %>'
})

watch(
  () => props.current,
  (val) => {
    if (val != undefined && !props.detailLoading) {
      <%= camelCase %>Form.value = val
    }
  },
)
</script>

<template>
  <el-dialog
    v-model="visible"
    :title="title"
    width="500"
    :close-on-click-modal="false"
    :close-on-press-escape="false"
    @closed="closeDialog"
    @open="openDialog"
  >
    <el-form :model="<%= camelCase %>Form" ref="<%= camelCase %>FormRef" v-loading="detailLoading" :rules="rules">
      <el-row :gutter="18">
        <%fields.filter(field => field.isAdd).forEach(function(field){%>
          <% if(field.dictCode) { %>
            <el-col :span="rowSpan">
              <el-form-item label="<%= field.nameCh%>" prop="<%= field.nameJson %>">
                <% if(field.formItemType === 'radio') { %>
                  <el-radio-group v-model="<%= camelCase %>Form.<%= field.nameJson %>">
                    <el-radio
                            v-for="dict in <%= field.dictCode %>"
                            :key="dict.value"
                            :value="dict.value"
                    >{{ dict.label }}</el-radio>
                  </el-radio-group>
                <%} else {%>
                  <el-select v-model="<%= camelCase %>Form.<%= field.nameJson %>">
                    <el-option
                            v-for="dict in <%= field.dictCode %>Options"
                            :key="dict.value"
                            :value="dict.value"
                            :label="dict.label"
                    ></el-option>
                  </el-select>
                <%}%>
              </el-form-item>
            </el-col>
          <% } else if(field.type === 'Int'){ %>
            <el-col :span="rowSpan">
              <el-form-item label="<%= field.nameCh%>" prop="<%= field.nameJson %>">
                <el-input-number
                        v-model="<%= camelCase %>Form.<%= field.nameJson %>"
                        controls-position="right"
                />
              </el-form-item>
            </el-col>
          <% } else if(field.type === 'Boolean'){ %>
            <el-col :span="rowSpan">
              <el-form-item label="<%= field.nameCh%>" prop="<%= field.nameJson %>">
                <el-switch v-model="<%= camelCase %>Form.<%= field.nameJson %>" />
              </el-form-item>
            </el-col>
          <%} else if (field.formItemType === 'textarea') {%>
            <el-col :span="rowSpan">
              <el-form-item label="<%= field.nameCh%>" prop="<%= field.nameJson %>">
                <el-input
                        v-model.trim="<%= camelCase %>Form.<%= field.nameJson %>"
                        show-word-limit
                        maxlength="<%=field.size%>"
                        placeholder="请输入<%= field.nameCh%>"
                        type="textarea"
                />
              </el-form-item>
            </el-col>
          <%} else {%>
            <el-col :span="rowSpan">
              <el-form-item label="<%= field.nameCh%>" prop="<%= field.nameJson %>">
                <el-input v-model.trim="<%= camelCase %>Form.<%= field.nameJson %>" placeholder="请输入<%= field.nameCh%>" />
              </el-form-item>
            </el-col>
          <% } %>
        <%})%>
      </el-row>
    </el-form>
    <template #footer>
      <div class="dialog-footer">
        <el-button @click="cancel">取消</el-button>
        <el-button type="primary" @click="confirm" :loading="loading"> 确认 </el-button>
      </div>
    </template>
  </el-dialog>
</template>

<style scoped></style>

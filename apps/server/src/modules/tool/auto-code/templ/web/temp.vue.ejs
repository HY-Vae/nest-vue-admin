<template>
  <div class="page-container <%= camelCase %>-container">
    <el-card class="search-bar">
      <el-form :model="search<%= pascalCase %>Form" :label-width="searchlabelWith" @keydown.enter="on<%= pascalCase %>Search"
               @submit.prevent>
        <el-row :gutter="24">
          <%fields.forEach(function(field){%>
            <% if(field.isSearch){%>
              <% if(field.dictCode) { %>
            <el-col v-bind="searchSpan">
                <el-form-item label="<%= field.nameCh%>" prop="<%= field.nameJson %>">
                  <el-select
                          v-model="search<%= pascalCase %>Form.<%= field.nameJson %>"
                          placeholder="请选择<%= field.nameCh%>"
                          clearable
                          style="width: 200px"
                  >
                    <el-option
                            v-for="dict in <%= field.dictCode%>Options"
                            :key="dict.value"
                            :label="dict.label"
                            :value="dict.value"
                    />
                  </el-select>
                </el-form-item>
            </el-col>
              <%} else {%>
                <el-col v-bind="searchSpan">

                <el-form-item label="<%= field.nameCh%>" prop="<%= field.nameJson %>">
                  <el-input
                          v-model.trim="search<%= pascalCase %>Form.<%= field.nameJson %>"
                          placeholder="请输入<%= field.nameCh%>"
                          clearable
                          style="width: 200px"
                          @keyup.enter="on<%= pascalCase %>Search"
                  />
                </el-form-item>
                </el-col>
              <% } %>
            <% } %>
          <%})%>
          <el-col v-bind="searchSpan">
            <el-form-item>
              <el-button type="primary" plain @click="on<%= pascalCase %>Search">搜索</el-button>
              <el-button plain @click="on<%= pascalCase %>Reset">重置</el-button>
            </el-form-item>
          </el-col>
        </el-row>
      </el-form>
    </el-card>
    <el-card class="table-container">
      <el-row class="table-bar">
        <el-button type="primary" :icon="Plus" v-auth="'<%= authPrefix %>:create'" @click="add<%= pascalCase %>">新增</el-button>
        <el-button
          type="danger"
          :icon="Delete"
          v-auth="'<%= authPrefix %>:removes'"
          :disabled="!selected<%= pascalCase %>Ids.length"
          @click="del<%= pascalCase %>s(DeleteEnum.Multiple)"
        >
          批量删除
        </el-button>
      </el-row>
      <div class="table-main" v-loading="queryLoading">
        <el-table
          :data="tableData"
          border
          row-key="<%= primaryKey %>"
          @selection-change="<%= camelCase %>SelectionChange"
        >
          <el-table-column type="selection" width="55" align="center" />
          <% fields.filter(field => field.isShowTable).forEach(function(field){ %>
            <% if (field.dictCode) { %>
              <el-table-column label="<%= field.nameCh %>" align="center" prop="<%= field.nameJson %>">
                <template #default="scope">
                  {{ getDictLabel(<%= field.dictCode %>Options, scope.row.<%= field.nameJson %>) }}
                </template>
              </el-table-column>
            <% } else if(field.type === 'DateTime'){ %>
              <el-table-column
                      label="<%= field.nameCh%>"
                      align="center"
                      width="180"
              >
                <template #default="scope">
                  <span>{{ transTime(scope.row.<%= field.nameJson %>) }}</span>
                </template>
              </el-table-column>
            <% } else {%>
              <el-table-column label="<%= field.nameCh %>" align="center" prop="<%= field.nameJson %>" />
            <% } %>
          <% })%>

          <el-table-column label="操作" width="110">
            <template #default="scope">
              <el-button type="primary" v-auth="'<%= authPrefix %>:update'" link @click="update<%= pascalCase %>(scope.row)">修改</el-button>
              <el-button type="danger" v-auth="'<%= authPrefix %>:remove'" link @click="del<%= pascalCase %>s(DeleteEnum.Single, scope.row)"
                >删除</el-button
              >
            </template>
          </el-table-column>
          <template #empty>
            <el-empty :image-size="200" />
          </template>
        </el-table>
      </div>
      <el-row justify="end">
        <el-pagination
          class="table-pagination"
          v-model:current-page="search<%= pascalCase %>Form.current"
          v-model:page-size="search<%= pascalCase %>Form.pageSize"
          :page-sizes="[10, 20, 50, 100]"
          layout="total, sizes, prev, pager, next, jumper"
          :total="total"
          @size-change="handleSizeChange"
          @current-change="handleCurrentChange"
        />
      </el-row>
    </el-card>
    <<%= camelCase %>-dialog
      :action="action"
      :loading="actionLoading"
      :detailLoading="detailLoading"
      :current="current<%= pascalCase %>"
      v-model="visible"
      @cancel="cancelDialog"
      @confirm="runAction<%= pascalCase %>"
    />
  </div>
</template>
<script setup lang="ts">
import { ref } from 'vue'
import { Delete, Plus } from '@element-plus/icons-vue'
import {
  add<%= pascalCase %>Api,
  delete<%= pascalCase %>Api,
  delete<%= pascalCase %>sApi,
  get<%= pascalCase %>Api,
  get<%= pascalCase %>OneApi,
  update<%= pascalCase %>Api,
} from './service'
import <%= pascalCase %>Dialog from './<%= pascalCase %>Dialog.vue'
import { useRequest } from 'vue-request'
import { ActionEnum, DeleteEnum } from '@/enums/common.ts'
import type { Create<%= pascalCase %>Type, <%= pascalCase %>ListType, Update<%= pascalCase %>Type } from './<%= camelCase %>.type'
import { transTime } from '@/utils/util.ts'
import router from '@/router'
<% if(dictKeys && dictKeys.length > 0){%>
import { useDict } from '@/hooks/dict.hook'
import type { SelectOptionItem } from '@/types/global'
<%}%>


<% if(dictKeys && dictKeys.length > 0){%>
const { getDictOptions, getDictLabel } = useDict()
<%}%>

<% dictKeys && dictKeys.forEach(function(key) { %>
const <%= key %>Options = ref<SelectOptionItem[]>([])
getDictOptions('<%= key %>').then((res) => {
  <%= key %>Options.value = res
})
<% }); %>

const searchlabelWith = ref(80)

const searchSpan = ref({
  xs: 24,
  sm: 12,
  md: 8,
  lg: 6,
  xl: 4,
})

const search<%= pascalCase %>Form = ref({
  <% const searchFields = fields.filter(field => field.isSearch);
  if (searchFields.length > 0) { %>
  <%= searchFields.map(function(field) {
    return field.nameJson + ': undefined';
  }).join(',\n    ') %>,
  <% } %>
  current: 1,
  pageSize: 20,
})

const on<%= pascalCase %>Search = () => {
  search<%= pascalCase %>Form.value.current = 1
  runGet<%= pascalCase %>()
}

const on<%= pascalCase %>Reset = () => {
  search<%= pascalCase %>Form.value = {
    <% const resetSearchFields = fields.filter(field => field.isSearch);
    if (resetSearchFields.length > 0) { %>
    <%= resetSearchFields.map(function(field) {
      return field.nameJson + ': undefined';
    }).join(',\n    ') %>,
    <% } %>
    current: 1,
    pageSize: 20,
  }
  runGet<%= pascalCase %>()
}

const tableData = ref<<%= pascalCase %>ListType[]>([])
const total = ref(0)

const { loading: queryLoading, run: runGet<%= pascalCase %> } = useRequest(
  () => {
    return get<%= pascalCase %>Api({
      ...search<%= pascalCase %>Form.value,
    })
  },
  {
    manual: false,
    loadingKeep: 500,
    onSuccess: (res) => {
      tableData.value = res.data.list
      total.value = res.data.total
    },
  },
)

const handleSizeChange = () => {
  runGet<%= pascalCase %>()
}

const handleCurrentChange = () => {
  runGet<%= pascalCase %>()
}

const visible = ref<boolean>(false)
const action = ref<ActionEnum>(ActionEnum.Add)

const add<%= pascalCase %> = () => {
  action.value = ActionEnum.Add
  current<%= pascalCase %>.value = undefined
  visible.value = true
}

const cancelDialog = () => {}

const { loading: actionLoading, run: runAction<%= pascalCase %> } = useRequest(
  (values: Create<%= pascalCase %>Type | Update<%= pascalCase %>Type) => {
    if (action.value === ActionEnum.Add) {
      return add<%= pascalCase %>Api(values as Create<%= pascalCase %>Type)
    }
    return update<%= pascalCase %>Api(values as Update<%= pascalCase %>Type)
  },
  {
    loadingKeep: 500,
    onSuccess: (res) => {
      visible.value = false
      runGet<%= pascalCase %>()
      const message = action.value === ActionEnum.Add ? '新增<%= nameZh %>成功' : '修改<%= nameZh %>成功'
      ElMessage.success(message)
    },
  },
)
const current<%= pascalCase %> = ref<<%= pascalCase %>ListType | undefined>(undefined)
const { loading: detailLoading, run: runGet<%= pascalCase %>One } = useRequest(get<%= pascalCase %>OneApi, {
  loadingKeep: 500,
  onSuccess: (res) => {
    current<%= pascalCase %>.value = res.data
  },
})

const update<%= pascalCase %> = (row: <%= pascalCase %>ListType) => {
  action.value = ActionEnum.Edit
  visible.value = true
  runGet<%= pascalCase %>One(row.<%= primaryKey %>)
}

const { runAsync: runDelete<%= pascalCase %>s } = useRequest(
        (action: DeleteEnum, ids: <%= pimaryKeyType %>[]) => {
          if (action === DeleteEnum.Single) {
            return delete<%= pascalCase %>Api(ids[0] as <%= pimaryKeyType %>)
          }
          return delete<%= pascalCase %>sApi(ids)
        },
        {
          loadingKeep: 500,
        },
)

const del<%= pascalCase %>s = (delAction: DeleteEnum, row?: <%= pascalCase %>ListType) => {
  let message = '此操作将永久删除该<%= nameZh %>, 是否继续?'
  let <%= primaryKey %>s: <%= pimaryKeyType %>[] = []
  if (delAction === DeleteEnum.Single && row != undefined) {
    <%= primaryKey %>s = [row.<%= primaryKey %>]
  }
  if (delAction === DeleteEnum.Multiple) {
    message = `此操作将永久批量删除当前${selected<%= pascalCase %>Ids.value.length}个<%= nameZh %>, 是否继续?`
    <%= primaryKey %>s = selected<%= pascalCase %>Ids.value
  }
  ElMessageBox.confirm(message, '提示', {
    confirmButtonText: '确定',
    cancelButtonText: '取消',
    type: 'warning',
    beforeClose: (action, instance, done) => {
      if (action === 'confirm') {
        instance.confirmButtonLoading = true
        instance.confirmButtonText = '正在删除...'
        runDelete<%= pascalCase %>s(delAction, <%= primaryKey %>s)
          .then(() => {
            selected<%= pascalCase %>Ids.value = []
            instance.confirmButtonLoading = false
            instance.confirmButtonText = '确定'
            done()
          })
          .catch(() => {
            instance.confirmButtonLoading = false
            instance.confirmButtonText = '确定'
          })
      } else {
        done()
      }
    },
  }).then(() => {
    ElMessage.success('删除成功')
    runGet<%= pascalCase %>()
  })
}

const selected<%= pascalCase %>Ids = ref<<%= pimaryKeyType %>[]>([])
const <%= camelCase %>SelectionChange = (<%= camelCase %>s: <%= pascalCase %>ListType[]) => {
  selected<%= pascalCase %>Ids.value = <%= camelCase %>s.map((<%= camelCase %>) => <%= camelCase %>.<%= primaryKey %>)
}
</script>
<style scoped lang="scss">
.<%= camelCase %>-container {
}
</style>

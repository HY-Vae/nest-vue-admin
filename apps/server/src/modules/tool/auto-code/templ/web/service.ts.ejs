import request from '@/utils/request.ts'
import type { ListResult, Result } from '@/types/global.ts'
import type {
  Create<%= pascalCase %>Type,
  Query<%= pascalCase %>Type,
  <%= pascalCase %>ListType,
  Update<%= pascalCase %>Type,
} from './<%= camelCase %>.type'

export function get<%= pascalCase %>Api(params: Query<%= pascalCase %>Type): Promise<ListResult<<%= pascalCase %>ListType>> {
  return request('/<%= routePath %>', {
    method: 'GET',
    params,
  })
}

export function get<%= pascalCase %>OneApi(id: <%= pimaryKeyType %>): Promise<Result<<%= pascalCase %>ListType>> {
  return request(`/<%= routePath %>/${id}`, {
    method: 'GET',
  })
}

export function add<%= pascalCase %>Api(data: Create<%= pascalCase %>Type): Promise<Result> {
  return request('/<%= routePath %>', {
    method: 'POST',
    data,
  })
}

export function update<%= pascalCase %>Api(data: Update<%= pascalCase %>Type): Promise<Result> {
  return request(`/<%= routePath %>/${data.id}`, {
    method: 'PATCH',
    data,
  })
}

export function delete<%= pascalCase %>Api(id: <%= pimaryKeyType %>): Promise<Result> {
  return request(`/<%= routePath %>/${id}`, {
    method: 'DELETE',
  })
}

export function delete<%= pascalCase %>sApi(ids: <%= pimaryKeyType %>[]): Promise<Result> {
  return request(`/<%= routePath %>`, {
    method: 'DELETE',
    data: {
      ids,
    },
  })
}

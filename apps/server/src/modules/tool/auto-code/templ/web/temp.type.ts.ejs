export interface Query<%= pascalCase %>Type {
  <% fields.forEach(function(field) { %>
    <% if (field.isSearch) { %>
      <%= field.name %>?: <%= field.tsType %>
    <% } %>
  <% }); %>
  current?: number
  pageSize?: number
}

export interface <%= pascalCase %>ListType {
  <% fields.forEach(function(field) { %>
    <% if (field.isRequired || field.isPrimary) { %>
      <%= field.name %>: <%= field.tsType %>
    <% } else { %>
      <%= field.name %>?: <%= field.tsType %>
    <% } %>
<% }); %>
}

export interface Create<%= pascalCase %>Type {
<% fields.forEach(function(field) { %>
  <% if (field.isAdd) { %>
    <%= field.name %>: <%= field.tsType %>
  <% } %>
<% }); %>
}

export interface Update<%= pascalCase %>Type extends Partial<Create<%= pascalCase %>Type> {
  <%= primaryKey %>: <%= pimaryKeyType %>
}

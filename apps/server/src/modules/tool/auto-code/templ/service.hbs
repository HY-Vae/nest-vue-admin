import { Injectable } from '@nestjs/common';
import { PrismaService } from 'nestjs-prisma';
import {
  Create{{pascalCase}}Dto,
  Get{{pascalCase}}ListDto,
  Update{{pascalCase}}Dto,
} from './dto/req-{{camelCase}}.dto';
{{#unless primaryKeyIsNumber}}
  import { generateUUid } from '@/utils/util';
{{/unless}}
import { Prisma } from '@prisma/client';

@Injectable()
export class {{pascalCase}}Service {
  constructor(
  private readonly prisma: PrismaService
  ) {}

  /* 新增 */
  async create(create{{pascalCase}}Dto: Create{{pascalCase}}Dto) {

    {{#if primaryKeyIsNumber}}
      return this.prisma.{{camelCase}}.create({
        data: create{{pascalCase}}Dto,
      });
    {{else}}
      return this.prisma.{{camelCase}}.create({
        data: {
          ...create{{pascalCase}}Dto,
          {{primaryKey}}: generateUUid(),
        },
      });
    {{/if}}
  }

  /* 列表查询 */
  async findAll(query: Get{{pascalCase}}ListDto) {
    const { skip, take } = query;
    const where: Prisma.{{pascalCase}}WhereInput = {};
    {{#each fields}}
      {{{createQueryHelper this}}}
    {{/each}}
    const listPromise = this.prisma.{{camelCase}}.findMany({
      where,
      skip,
      take,
    });
    const totalPromise = this.prisma.{{camelCase}}.count({
      where,
    });
    const [list, total] = await Promise.all([listPromise, totalPromise]);
    return {
      list,
      total,
    };
  }

  /* 通过id查询 */
  async findOne({{primaryKey}}: {{pimaryKeyType}}) {
    return this.prisma.{{camelCase}}.findUnique({
      where: {
        {{primaryKey}},
      },
    });
  }

  /* 更新 */
  async update({{primaryKey}}: {{pimaryKeyType}}, update{{pascalCase}}Dto: Update{{pascalCase}}Dto) {
    return this.prisma.{{camelCase}}.update({
      where: {
        {{primaryKey}},
      },
      data: update{{pascalCase}}Dto,
    });
  }

  /* 删除 */
  async remove({{primaryKey}}: {{pimaryKeyType}}) {
    return this.prisma.{{camelCase}}.delete({
      where: {
        {{primaryKey}},
      },
    });
  }

  /* 批量删除 */
  async removes(ids: {{pimaryKeyType}}[]) {
    return this.prisma.{{camelCase}}.deleteMany({
      where: {
        id: {
          in: ids
        }
      },
    });
  }
}
